 "deviations": [
  {
   "what": "Οι ενότητες «Table Reservation» και η φόρμα κράτησης αφαιρέθηκαν",
   "why": "Το προϊόν δεν υποστηρίζει ροή κρατήσεων· αντικαταστάθηκαν από λευκή κάρτα με FindUs και στοιχεία επικοινωνίας."
  },
  {
   "what": "Η ενότητα «Our Chefs» αφαιρέθηκε",
   "why": "Ομαδικά προφίλ επιτρέπονται μόνο με REAL_OWNER_PERSON, το οποίο δεν υπάρχει."
  },
  {
   "what": "Το video modal και το κουμπί play στην ενότητα about αφαιρέθηκαν",
   "why": "Το video modal δεν υποστηρίζεται από το προϊόν."
  },
  {
   "what": "Το «Klassy Week» με tabs προσφορών αναπαραστάθηκε ως οριζόντια λίστα υπηρεσιών",
   "why": "Το μοντέλο δεδομένων διαθέτει μόνο d.services, όχι ξεχωριστή δομή εβδομαδιαίων προσφορών."
  },
  {
   "what": "Οι ετικέτες τιμών στα card του μενού παραλείπονται",
   "why": "Το d.services στο τρέχον demo δεν περιέχει price· ο κανόνας δεδομενοεξαρτώμενου UI απαιτεί παράλειψη. Εμφανίζεται μόνο το num ως αριθμητική ένδειξη."
  },
  {
   "what": "Table reservation form omitted",
   "why": "No booking flow exists in the Vitrina product; the white form card is repurposed to embed FindUs instead."
  },
  {
   "what": "Our Chefs section omitted",
   "why": "Team members require real owner/person data; none is available in the data contract."
  },
  {
   "what": "Video modal omitted",
   "why": "Video playback is not supported by the Vitrina stack."
  },
  {
   "what": "Weekly special tabs replaced with services list",
   "why": "The data contract provides services (title/desc/num) instead of tabbed offer meals; the original pricing badges become the service num badge."
  },
  {
   "what": "Hero carousel replaced by scroll-snap slider",
   "why": "Server component cannot use JS carousel; scroll-snap preserves the visual slider behavior without client JavaScript."
  },
  {
   "what": "Original Poppins/Dancing Script fonts approximated",
   "why": "Only the self-hosted font list is available; Manrope and Fraunces were chosen to preserve the geometric sans + display serif feel."
  }
