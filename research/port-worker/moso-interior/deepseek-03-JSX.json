      "content": "import s from './MosoShowroom.module.css'; import Brand from './Brand'; import FindUs from './FindUs'; import SocialLinks from './SocialLinks'; export default function MosoShowroom({ data: d }) { return ( <div className={s.root}> <nav className={s.nav} aria-label='Κύρια πλοήγηση'> <div className={s.navIn}> <a href='#home' className={s.logo}><Brand data={d} className={s.brand} /></a> <div className={s.navLinks}> <a href='#home'>Αρχική</a> <a href='#service'>Υπηρεσίες</a> <a href='#portfolio'>Έργα</a> <a href='#contact'>Επικοινωνία</a> </div> </div> </nav> <header id='home' className={s.hero}> <div className={s.heroImage} style={{ backgroundImage: 'url(' + d.HERO_IMAGE + ')' }} role='img' aria-label={d.TAGLINE} /> <div className={s.heroOverlay} /> <div className={s.heroContent}> <div className={s.heroInner}> <p className={s.kicker}>{d.KICKER}</p> <h1 className={s.heroTitle}>{d.TAGLINE}</h1> <div className={s.filterBar}> <span className={s.filterLabel}>Κατηγορίες</span> <div className={s.filterTags}> {d.gallery.map((item) => <a className={s.filterTag} key={item.title} href='#portfolio'>{item.title}</a>)} </div> <a className={s.filterCta} href='#contact'>{d.CTA_TITLE}</a> </div> </div> </div> </header> <section className={s.about} id='about'> <div className={s.sectionInner}> <div className={s.aboutText}> <p className={s.smallTitle}>Η ιστορία μας</p> <h2 className={s.sectionTitle}>{d.STORY_TITLE}</h2> <p className={s.paragraph}>{d.INTRO}</p> {d.story.map((p, i) => <p className={s.paragraph} key={i}>{p.p}</p>)} </div> <div className={s.aboutImages}> <img className={s.aboutImageMain} src={d.STORY_IMAGE} alt={d.STORY_TITLE} /> {d.gallery[0] ? <img className={s.aboutImageSmall} src={d.gallery[0].image} alt={d.gallery[0].title} /> : null} </div> </div> </section> <section className={s.featured} id='featured'> <div className={s.featuredBg} style={{ backgroundImage: 'url(' + d.STORY_IMAGE + ')' }} /> <div className={s.featuredOverlay} /> <div className={s.featuredCard}> <h3 className={s.featuredTitle}>Ωράριο Λειτουργίας</h3> <p className={s.featuredHours}>{d.HOURS}</p> </div> </section> <section className={s.services} id='service'> <div className={s.sectionInner}> <p className={s.smallTitle}>Υπηρεσίες</p> <h2 className={s.sectionTitle}>Τι προσφέρουμε</h2> <div className={s.servicesGrid}> {d.services.map((item) => ( <article className={s.serviceCard} key={item.title}> <span className={s.serviceNum}>{item.num}</span> <h3 className={s.serviceTitle}>{item.title}</h3> <p className={s.serviceDesc}>{item.desc}</p> </article> ))} </div> </div> </section> <section className={s.portfolio} id='portfolio'> <div className={s.sectionInner}> <p className={s.smallTitle}>{d.TRADE}</p> <h2 className={s.sectionTitle}>{d.CITY} · Έργα</h2> <div className={s.portfolioGrid}> {d.gallery.map((item) => ( <article className={s.portfolioCard} key={item.title}> <div className={s.portfolioMedia}> <img src={item.image} alt={item.title} /> </div> <div className={s.portfolioBody}> <h3 className={s.portfolioTitle}>{item.title}</h3> <p className={s.portfolioSub}>{item.sub}</p> </div> </article> ))} </div> </div> </section> <section className={s.contact} id='contact'> <div className={s.sectionInner}> <p className={s.smallTitle}>Επικοινωνία</p> <h2 className={s.sectionTitle}>Πες μας ένα γεια</h2> <div className={s.contactGrid}> <FindUs data={d} /> <SocialLinks data={d} className={s.socialLinks} /> </div> </div> <svg className={s.wave} viewBox='0 0 1440 100' preserveAspectRatio='none' aria-hidden='true'> <path fill='var(--vt-surface-deep)' d='M0,32L48,37.3C96,43,192,53,288,58.7C384,64,480,64,576,58.7C672,53,768,43,864,42.7C960,43,1056,53,1152,58.7C1248,64,1344,69,1392,72L1440,75L1440,100L0,100Z' /> </svg> </section> <footer className={s.footer}> <div className={s.sectionInner}> <div className={s.footerTop}> <Brand data={d} className={s.footerBrand} dark /> <SocialLinks data={d} className={s.socialLinks} /> </div> <p className={s.copyright}>© {d.YEAR} {d.NAME}, {d.CITY}</p> </div> </footer> </div> ); }"
    }
