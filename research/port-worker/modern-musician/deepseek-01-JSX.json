{
  "theme_key": "modern-musician",
  "component": "StudioSignature",
  "files": [
    {
      "path": "sites/lib/templates/StudioSignature.jsx",
      "content": "import s from './StudioSignature.module.css'\nimport Brand from './Brand'\nimport FindUs from './FindUs'\nimport SocialLinks from './SocialLinks'\n\nconst icons = [\n  <svg key='prod' width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth='2' strokeLinecap='round' strokeLinejoin='round'>\n    <path d='M9 18V5l12-2v13' />\n    <circle cx='6' cy='18' r='3' />\n    <circle cx='18' cy='16' r='3' />\n  </svg>,\n  <svg key='content' width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth='2' strokeLinecap='round' strokeLinejoin='round'>\n    <polygon points='23 7 16 12 23 17 23 7' />\n    <rect x='1' y='5' width='15' height='14' rx='2' ry='2' />\n  </svg>,\n  <svg key='teach' width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth='2' strokeLinecap='round' strokeLinejoin='round'>\n    <path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2' />\n    <circle cx='9' cy='7' r='4' />\n    <path d='M23 21v-2a4 4 0 0 0-3-3.87' />\n    <path d='M16 3.13a4 4 0 0 1 0 7.75' />\n  </svg>\n]\n\nexport default function StudioSignature({ data: d }) {\n  const hasHeroImage = Boolean(d.HERO_IMAGE)\n  const hasStory = Array.isArray(d.story) && d.story.length > 0\n  const hasServices = Array.isArray(d.services) && d.services.length > 0\n  const hasGallery = Array.isArray(d.gallery) && d.gallery.length > 0\n  const heroGridClass = hasHeroImage ? s.heroGridMedia : s.heroGrid\n\n  return (\n    <div className={s.root}>\n      <nav className={s.nav} aria-label='Κύρια πλοήγηση'>\n        <div className={s.navIn}>\n          <a href='#home' className={s.logo}><Brand data={d} className={s.brand} dark /></a>\n          <div className={s.navLinks}>\n            <a href='#home'>Αρχική</a>\n            <a href='#service'>Υπηρεσίες</a>\n            <a href='#portfolio'>Έργα</a>\n            <a href='#contact'>Επικοινωνία</a>\n          </div>\n        </div>\n      </nav>\n\n      <header id='home' className={s.hero}>\n        <div className={s.container}>\n          <div className={heroGridClass}>\n            <div className={s.heroContent}>\n              {d.KICKER ? <p className={s.heroTagline}>{d.KICKER}</p> : null}\n              <h1>{d.HERO_WORD || d.NAME}</h1>\n              {d.INTRO ? <p className={s.heroDescription}>{d.INTRO}</p> : null}\n              <div className={s.btnGroup}>\n                <a href='#portfolio' className={s.btnPrimary}>Έργα</a>\n                <a href='#contact' className={s.btnGhost}>Επικοινωνία</a>\n              </div>\n            </div>\n            {hasHeroImage ? (\n              <div className={s.heroVisual}>\n                <div className={s.heroCard}>\n                  <img src={d.HERO_IMAGE} alt={d.NAME || ''} />\n                  <div className={s.heroCardInfo}>\n                    {d.TRADE ? <span className={s.heroBadge}>{d.TRADE}</span> : null}\n                    {d.NAME ? <h3>{d.NAME}</h3> : null}\n                    {d.CITY ? <p>{d.CITY}</p> : null}\n                  </div>\n                </div>\n              </div>\n            ) : null}\n          </div>\n        </div>\n      </header>\n\n      {hasStory ? (\n        <section id='about' className={s.about}>\n          <div className={s.container}>\n            <div className={s.aboutGrid}>\n              {d.STORY_IMAGE ? (\n                <div className={s.aboutImage}>\n                  <img src={d.STORY_IMAGE} alt={d.NAME || ''} />\n                </div>\n              ) : null}\n              <div className={s.aboutText}>\n                <span className={s.sectionLabel}>Σχετικά</span>\n                <h2>{d.STORY_TITLE}</h2>\n                {d.story.map((item, i) => (\n                  <p key={i}>{item.p}</p>\n                ))}\n              </div>\n            </div>\n          </div>\n        </section>\n      ) : null}\n\n      {hasServices ? (\n        <section id='service' className={s.services}>\n          <div className={s.container}>\n            <span className={s.sectionLabel}>Υπηρεσίες</span>\n            <h2>Πώς μπορώ να βοηθήσω</h2>\n            <div className={s.servicesGrid}>\n              {d.services.map((item, i) => (\n                <article className={s.serviceCard} key={i}>\n                  {item.num ? <span className={s.serviceNum}>{item.num}</span> : null}\n                  <span className={s.serviceIcon} aria-hidden='true'>\n                    {icons[i % icons.length]}\n                  </span>\n                  <h3>{item.title}</h3>\n                  <p>{item.desc}</p>\n                  {item.duration || item.price ? (\n                    <div className={s.serviceMeta}>\n                      {item.duration ? <span>{item.duration}</span> : null}\n                      {item.price ? <span>{item.price}</span> : null}\n                    </div>\n                  ) : null}\n                </article>\n              ))}\n            </div>\n          </div>\n        </section>\n      ) : null}\n\n      {hasGallery ? (\n        <section id='portfolio' className={s.portfolio}>\n          <div className={s.container}>\n            <span className={s.sectionLabel}>Έργα</span>\n            <h2>Επιλεγμένα έργα</h2>\n            <div className={s.workGrid}>\n              {d.gallery.map((item, i) => (\n                <article className={s.workCard} key={i}>\n                  <div className={s.workImage}>\n                    <img src={item.image} alt={item.title || ''} />\n                  </div>\n                  <div className={s.workInfo}>\n                    {item.sub ? <span className={s.workCategory}>{item.sub}</span> : null}\n                    <h3>{item.title}</h3>\n                  </div>\n                </article>\n              ))}\n            </div>\n          </div>\n        </section>\n      ) : null}\n\n      <section id='contact' className={s.contact}>\n        <