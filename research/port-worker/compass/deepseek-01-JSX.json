{
  "theme_key": "compass-journal",
  "component": "CompassJournal",
  "files": [
    {
      "path": "sites/lib/templates/CompassJournal.jsx",
      "content": "import s from './CompassJournal.module.css'\nimport Brand from './Brand'\nimport FindUs from './FindUs'\nimport SocialLinks from './SocialLinks'\n\nexport default function CompassJournal({ data: d }) {\n  return (\n    <div className={s.root}>\n      <nav className={s.nav} aria-label='Κύρια πλοήγηση'>\n        <input type='checkbox' id='compass-nav-toggle' className={s.navToggleInput} />\n        <div className={s.navIn}>\n          <a href='#home' className={s.logo}><Brand data={d} className={s.brand} dark /></a>\n          <div className={s.navLinks}>\n            <a href='#home'>Αρχική</a>\n            <a href='#story'>Η Ιστορία</a>\n            <a href='#services'>Υπηρεσίες</a>\n            <a href='#gallery'>Έργα</a>\n            <a href='#contact'>Επικοινωνία</a>\n          </div>\n          <label htmlFor='compass-nav-toggle' className={s.navToggle} aria-label='Εναλλαγή μενού'>\n            <span></span><span></span><span></span>\n          </label>\n        </div>\n        <div className={s.navDrawer}>\n          <label htmlFor='compass-nav-toggle' className={s.navDrawerClose} aria-label='Κλείσιμο μενού'>&times;</label>\n          <a href='#home'>Αρχική</a>\n          <a href='#story'>Η Ιστορία</a>\n          <a href='#services'>Υπηρεσίες</a>\n          <a href='#gallery'>Έργα</a>\n          <a href='#contact'>Επικοινωνία</a>\n        </div>\n      </nav>\n\n      <header id='home' className={s.hero}>\n        <div className={s.heroImage}>\n          <img className={s.heroImg} src={d.HERO_IMAGE} alt={`${d.NAME} — ${d.TRADE}`} loading='eager' />\n        </div>\n        <div className={s.heroContent}>\n          <p className={s.heroEyebrow}>{d.KICKER} — {d.YEAR}</p>\n          <h1 className={s.heroTitle}>\n            <span className={s.heroTitleLine}>{d.TRADE}</span>\n            <em className={s.heroTitleEm}>{d.HERO_WORD}</em>\n          </h1>\n          <div className={s.heroMeta}>\n            <span>{d.NAME}</span>\n            <span className={s.heroMetaDivider}></span>\n            <span>{d.CITY}</span>\n          </div>\n        </div>\n        <div className={s.heroScroll}>Εξερεύνησε</div>\n      </header>\n\n      <section id='story' className={s.prologue}>\n        <div className={s.prologueInner}>\n          <p className={s.prologueLabel}>{d.STORY_TITLE || 'Εισαγωγή'}</p>\n          {d.story && d.story[0] ? <p className={`${s.prologueText} ${s.prologueTextFirst}`}>{d.story[0].p}</p> : <p className={`${s.prologueText} ${s.prologueTextFirst}`}>{d.INTRO}</p>}\n          <blockquote className={s.pullquote}>\n            <p className={s.pullquoteText}>“{d.TAGLINE}”</p>\n            <cite className={s.pullquoteCite}>— {d.NAME}</cite>\n          </blockquote>\n          {d.story && d.story.slice(1).map((para, i) => (\n            <p key={i} className={s.prologueText}>{para.p}</p>\n          ))}\n        </div>\n      </section>\n\n      <section id='services' className={s.route}>\n        <div className={s.routeLabel}>Η Διαδρομή</div>\n        <div className={s.chapters}>\n          {d.services.map((service, i) => (\n            <article key={i} className={s.chapter}>\n              <div className={s.chapterMedia}>\n                {d.gallery[i]?.image ? <img className={s.chapterImg} src={d.gallery[i].image} alt={d.gallery[i].title || service.title} loading='lazy' /> : null}\n              </div>\n              <div className={s.chapterBody}>\n                <div className={s.chapterNumber}>{service.num || String(i + 1).padStart(2, '0')}</div>\n                <p className={s.chapterLocation}>{d.AREAS}</p>\n                <h2 className={s.chapterTitle}>{service.title}</h2>\n                <p className={s.chapterDesc}>{service