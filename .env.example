# Αντίγραψέ το σε .env και συμπλήρωσε. ΠΟΤΕ μη βάλεις πραγματικά κλειδιά εδώ —
# αυτό το αρχείο μπαίνει στο git, το .env όχι.

# --- Υποχρεωτικά -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
APP_BASE_URL=http://localhost:8000

# --- AI (προαιρετικό) ------------------------------------------------------
# Χωρίς αυτό όλα δουλεύουν με έτοιμα πρότυπα ανά επάγγελμα. Ξεκλειδώνει το
# chat-to-edit και τις AI λεζάντες. Δούλεψε με όποιον πάροχο βρεις:
#
#   DeepSeek (φθηνό, OpenAI-συμβατό)
#     AI_API_KEY=sk-...
#     AI_BASE_URL=https://api.deepseek.com/v1
#     AI_MODEL=deepseek-chat
#
#   Anthropic (καλύτερα ελληνικά, ακριβότερο)
#     AI_API_KEY=sk-ant-...        ← και ΤΙΠΟΤΑ άλλο, χωρίς base URL
#
# Έλεγχος: python scripts/check_ai.py
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# anthropic | openai | κενό = αυτόματη ανίχνευση από τη μορφή του κλειδιού
AI_PROVIDER=

# Παλιά ονόματα — δουλεύουν ακόμα ως εφεδρικά για τα AI_* παραπάνω.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# --- Domains πελατών (προαιρετικό) -----------------------------------------
# Το token θέλει Zone→DNS→Edit και Zone→Workers Routes→Edit.
CF_API_TOKEN=
CF_ACCOUNT_ID=
RAILWAY_TOKEN=

# --- Πληρωμές (test mode) --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SITE=
STRIPE_PRICE_SOCIAL=
STRIPE_PRICE_PREMIUM=

# --- Facebook/Instagram (περιμένει Meta App Review) ------------------------
META_APP_ID=
META_APP_SECRET=

# --- Registrar (δεν έχει ενεργοποιηθεί ακόμα) ------------------------------
PAPAKI_API_KEY=
PAPAKI_API_BASE=
PAPAKI_RESELLER_ID=
PAPAKI_CONTACT_ID=
