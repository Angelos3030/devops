# Αντίγραψέ το σε .env και συμπλήρωσε. ΠΟΤΕ μη βάλεις πραγματικά κλειδιά εδώ —
# αυτό το αρχείο μπαίνει στο git, το .env όχι.

# --- Υποχρεωτικά -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
APP_BASE_URL=http://localhost:8000

# --- AI (προαιρετικό) ------------------------------------------------------
# Χωρίς αυτό όλα δουλεύουν με έτοιμα πρότυπα ανά επάγγελμα. Ξεκλειδώνει το
# chat-to-edit και τα AI κείμενα. Κλειδί sk-ant-... από console.anthropic.com.
ANTHROPIC_API_KEY=
# Μόνο για εναλλακτικό provider (π.χ. Azure Foundry) — θέλει ΚΑΙ τα δύο.
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# --- Domains πελατών (προαιρετικό) -----------------------------------------
# Το token θέλει Zone→DNS→Edit και Zone→Workers Routes→Edit.
CF_API_TOKEN=
CF_ACCOUNT_ID=
RAILWAY_TOKEN=

# --- Πληρωμές (test mode) --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SITE=
STRIPE_PRICE_SOCIAL=
STRIPE_PRICE_PREMIUM=

# --- Facebook/Instagram (περιμένει Meta App Review) ------------------------
META_APP_ID=
META_APP_SECRET=

# --- Registrar (δεν έχει ενεργοποιηθεί ακόμα) ------------------------------
PAPAKI_API_KEY=
PAPAKI_API_BASE=
PAPAKI_RESELLER_ID=
PAPAKI_CONTACT_ID=
